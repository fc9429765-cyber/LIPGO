# Plantilla de variables de entorno de LIPgo.
# Copia este archivo como .env.local y completa con los valores reales.
# .env.local está en .gitignore — NUNCA subir credenciales al repo.

# Supabase (proyecto)
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_publica
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_secreta
SUPABASE_SECRET_KEY=sb_secret_xxx

# Opcionales
# GOOGLE_GENERATIVE_AI_API_KEY=  # Gemini (asistente IA)
# BLOB_READ_WRITE_TOKEN=         # Vercel Blob

# Compliance (app.compliance.com.co) — Consultar Antecedentes.
# Credenciales del servicio REST para generar el token (Basic auth).
# COMPLIANCE_USER=              # usuario del servicio Compliance
# COMPLIANCE_PASS=              # clave del servicio Compliance
# COMPLIANCE_BASE_URL=https://app.compliance.com.co/validador  # opcional
# COMPLIANCE_ACCESS_CODE=       # código que protege la Investigación en Compliance

# Correo transaccional (Resend, https://resend.com) — hoy lo usa la recuperación
# de la CLAVE DE AUTORIZACIÓN (código de 6 dígitos al correo del usuario).
# Sin RESEND_API_KEY la recuperación por correo queda desactivada y aplica el
# camino asistido: clave provisional desde Configuración › Autorizaciones por clave.
# El remitente debe ser de un dominio verificado en Resend.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=LIPgo <no-reply@lip-sas.com>

# WhatsApp (Meta Cloud API) — Notificaciones al Personal.
# Mientras WHATSAPP_ENABLED != "true", el modulo funciona en MODO PRUEBA:
# registra los envios en `notificaciones_enviadas` sin llamar a Meta ni
# gastar. Cuando el negocio este verificado y las plantillas aprobadas,
# pon WHATSAPP_ENABLED=true y completa las credenciales.
# WHATSAPP_ENABLED=false
# WHATSAPP_PHONE_NUMBER_ID=      # ID del numero de WhatsApp en Meta
# WHATSAPP_ACCESS_TOKEN=         # Token de acceso (System User, permanente)
# WHATSAPP_GRAPH_VERSION=v21.0   # Opcional; version de la Graph API
